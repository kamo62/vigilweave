DATABASE_URL=sqlite:///./vigilweave.db
# Note: If upgrading from a previous version using 'codeguard.db', the system will
# automatically migrate your data to 'vigilweave.db' on first startup.
# The old database file will not be modified or deleted.
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false
HOST_REPO_ROOT=
CONTAINER_REPO_ROOT=/workspace

# Docker Compose host-to-container local repo mapping
VIGILWEAVE_HOST_REPO_ROOT=.
VIGILWEAVE_CONTAINER_REPO_ROOT=/workspace

# License Configuration
# For development/testing: Set LICENSE_TESTING_MODE=true to unlock all features
# LICENSE_TESTING_MODE=true

# For production: Set your actual license key
# LICENSE_KEY=vw-pro-yourorg-hash123
# LICENSE_KEY=vw-ent-yourorg-hash123
# LICENSE_KEY=vw-ent-offline-yourorg-signature123

# License server settings (defaults are usually fine)
# LICENSE_SERVER_URL=https://license.vigilweave.com/v1/verify
# LICENSE_VERIFY_TIMEOUT_SECONDS=5
# LICENSE_CACHE_TTL_HOURS=24

# HMAC secret for Enterprise Offline key validation.
# MUST be set to a random value in production (e.g. openssl rand -hex 32).
# If unset, uses an insecure placeholder — fine for dev, NOT for production.
# OFFLINE_LICENSE_SECRET=

# --- Timeout tuning (seconds) ---
# TOOL_EXECUTION_TIMEOUT_SECONDS=600
# GIT_CLONE_TIMEOUT_SECONDS=120
# GIT_BLAME_TIMEOUT_SECONDS=60
# EXTERNAL_API_TIMEOUT_SECONDS=30
# GITHUB_API_TIMEOUT_SECONDS=20
# AZURE_API_TIMEOUT_SECONDS=20
# ALLOW_HTTP_OUTBOUND=false
# ENABLE_REPO_BUILD_TOOL_ADAPTERS=false

# --- Rate limiting ---
# RATE_LIMIT_PDF_MAX_REQUESTS=10
# RATE_LIMIT_PDF_WINDOW_SECONDS=60
# RATE_LIMIT_CSV_MAX_REQUESTS=30
# RATE_LIMIT_CSV_WINDOW_SECONDS=60
# RATE_LIMIT_WEBHOOK_MAX_REQUESTS=120
# RATE_LIMIT_WEBHOOK_WINDOW_SECONDS=60
# RATE_LIMIT_CLEANUP_INTERVAL=100

# --- Pagination defaults ---
# DEFAULT_SCAN_LIST_LIMIT=50
# MAX_SCAN_LIST_LIMIT=500
# DEFAULT_FINDINGS_LIMIT=500
# MAX_FINDINGS_LIMIT=5000
# MAX_BULK_TRIAGE_IDS=1000
# DEFAULT_AUDIT_EVENTS_LIMIT=200
# MAX_AUDIT_EVENTS_LIMIT=1000
# MAX_REGEX_PATTERN_LENGTH=200

# --- Observability ---
# METRICS_MAX_KEYS=10000

# --- Request size limits ---
# WEBHOOK_MAX_REQUEST_BODY_BYTES=1048576

# --- Worker Scaling ---
# WORKER_REPLICAS=1          # Number of Celery worker containers (default: 1, enterprise override: 2)
# CELERY_CONCURRENCY=2       # Tasks per worker process (default: 2, enterprise override: 4)

# --- Browser Session Authentication ---
# Self-hosted default: built-in local users + API keys for automation.
# SESSION_AUTH_PROVIDER=local  # none | local | workos
# API_KEYS_ENABLED=true
# SESSION_SECRET=<openssl rand -hex 32>  # required in production for browser sessions

# --- Token Encryption ---
# Dedicated key for encrypting stored SCM tokens. If unset, falls back to
# SESSION_SECRET (not recommended — rotating the session secret would break
# all stored tokens). Generate with: openssl rand -hex 32
# TOKEN_ENCRYPTION_KEY=<openssl rand -hex 32>
#
# Legacy compatibility (deprecated):
# AUTH_MODE=api_key  # api_key | workos | dual
#
# --- SaaS Platform ---
# SAAS_ENABLED=false
# SAAS_DOMAIN=app.vigilweave.com
# MARKETING_DOMAIN=https://vigilweave.com   # Added to CORS allowed origins

# --- Frontend Domain Split (build-time args for Docker) ---
# When deploying with separate marketing and app domains, set these
# in the frontend Docker build so the SPA knows which domain it's on.
# VITE_MARKETING_URL=https://vigilweave.com
# VITE_APP_URL=https://app.vigilweave.com

# WorkOS AuthKit Configuration (required for SaaS)
# WORKOS_API_KEY=sk_...
# WORKOS_CLIENT_ID=client_...
# WORKOS_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
# WORKOS_COOKIE_DOMAIN=localhost
# WORKOS_SESSION_SECRET=<openssl rand -hex 32>  # legacy alias for SESSION_SECRET

# To run the SaaS / enterprise runtime, use:
# docker compose -f docker-compose.yml -f docker-compose.enterprise.yml up -d --build
