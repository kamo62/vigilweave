apiVersion: v1
kind: ConfigMap
metadata:
  name: vigilweave-config
  namespace: vigilweave
data:
  ENVIRONMENT: "production"
  DATABASE_URL: "${DATABASE_URL}"
  REDIS_URL: "${REDIS_URL}"
  CELERY_TASK_ALWAYS_EAGER: "false"
  TOOLCHAIN_PROFILE: "${TOOLCHAIN_PROFILE}"
  SESSION_AUTH_PROVIDER: "${SESSION_AUTH_PROVIDER}"
  API_KEYS_ENABLED: "${API_KEYS_ENABLED}"
  SAAS_ENABLED: "${SAAS_ENABLED}"
  LICENSE_TESTING_MODE: "${LICENSE_TESTING_MODE}"
  CELERY_CONCURRENCY: "${CELERY_CONCURRENCY}"
  VIGILWEAVE_WEB_BASE_URL: "${VIGILWEAVE_WEB_BASE_URL}"
  VIGILWEAVE_API_BASE_URL: "${VIGILWEAVE_API_BASE_URL}"
  LICENSE_SERVER_URL: "${LICENSE_SERVER_URL}"
  LICENSE_SERVER_API_BASE_URL: "${LICENSE_SERVER_API_BASE_URL}"
  MARKETING_DOMAIN: "${MARKETING_DOMAIN}"
  WORKOS_COOKIE_DOMAIN: "${WORKOS_COOKIE_DOMAIN}"
  PADDLE_ENVIRONMENT: "${PADDLE_ENVIRONMENT}"
  PADDLE_CLIENT_TOKEN: "${PADDLE_CLIENT_TOKEN}"
  PADDLE_PRICE_ID_PRO: "${PADDLE_PRICE_ID_PRO}"
  PADDLE_PRICE_ID_ENTERPRISE: "${PADDLE_PRICE_ID_ENTERPRISE}"
  PADDLE_PRICE_ID_SELF_HOSTED_PRO: "${PADDLE_PRICE_ID_SELF_HOSTED_PRO}"
  PADDLE_PRICE_ID_SELF_HOSTED_ENTERPRISE: "${PADDLE_PRICE_ID_SELF_HOSTED_ENTERPRISE}"
  ENABLE_FILE_REPO_ACCESS: "false"
  ALLOW_PRIVATE_SCM_BASE_URLS: "false"
